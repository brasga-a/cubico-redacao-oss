{
  "name": "cubico-redacao",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test",
    "kb:ingest": "uv run --with pymupdf --with fonttools python3 scripts/cartilhas/ingest.py run --pdf-dir ../../data --out data/knowledge",
    "kb:verify": "uv run --with pymupdf --with fonttools python3 scripts/cartilhas/ingest.py verify --out data/knowledge",
    "kb:test": "uv run --with pymupdf --with fonttools python3 -m unittest discover -s scripts/cartilhas/tests",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "cf:build": "cf build",
    "cf:dev": "cf dev",
    "db:migrate:local": "node scripts/d1-migrate.mjs --local",
    "db:migrate:remote": "node scripts/d1-migrate.mjs --remote",
    "deploy:dry-run": "cf deploy --dry-run",
    "deploy": "bash scripts/deploy.sh",
    "visual:dev": "vite --config vite.visual.config.ts",
    "visual:build": "vite build --config vite.visual.config.ts",
    "test:visual": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.112",
    "@ai-sdk/react": "4.0.167",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "ai": "7.0.163",
    "better-auth": "1.7.17",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "motion": "12.43.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.18.0",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
