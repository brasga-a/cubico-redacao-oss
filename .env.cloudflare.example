# Configuração NÃO secreta da sua conta Cloudflare, lida por cloudflare.config.ts.
#   cp .env.cloudflare.example .env.cloudflare
# Variáveis de ambiente do processo têm prioridade sobre este arquivo.
# Segredos (OAuth, Gemini, Better Auth) ficam em .dev.vars / arquivo de deploy, nunca aqui.

# Nome do Worker (padrão: cubico-redacao)
CUBICO_WORKER_NAME=cubico-redacao
# Domínio personalizado (opcional; sem ele o deploy usa *.workers.dev)
# CUBICO_DOMAIN=redacao.exemplo.com
# Banco D1: crie com `cf d1 create cubico-redacao-db` e cole o ID.
# Sem ID, o desenvolvimento local usa um ID fictício e migrations remotas/deploy são recusados.
CUBICO_D1_NAME=cubico-redacao-db
# CUBICO_D1_ID=00000000-0000-0000-0000-000000000000
# Bucket R2 privado para avatares
CUBICO_R2_BUCKET=cubico-avatars
# Namespace do rate limiter (inteiro único na conta)
CUBICO_RATE_LIMIT_NAMESPACE=1001
